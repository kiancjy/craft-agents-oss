# Team access for Pages — settings for pages-team.service.
# Copy to ~/.config/craft-agents/pages-team.env and set mode 600.

# The workspace whose pages the team server serves
PAGES_TEAM_WORKSPACE_ROOT=/home/kian/.craft-agent/workspaces/work

# The Owner. This account is always the Owner and cannot be changed from the team link.
PAGES_TEAM_OWNER_EMAIL=kian@getincredible.com
PAGES_TEAM_OWNER_NAME=Kian

# Only accounts at this domain get a role
PAGES_TEAM_ALLOWED_DOMAIN=getincredible.com

# The team link address (no trailing slash)
PAGES_TEAM_PUBLIC_URL=https://pages.getincredible.com

# Cloudflare Access. Both values come from the Zero Trust dashboard (see SETUP.md).
# Without them, the team port refuses every request.
PAGES_TEAM_ACCESS_TEAM_DOMAIN=incredible.cloudflareaccess.com
PAGES_TEAM_ACCESS_AUD=

# Ports and the owner secret file. The defaults are correct for this server.
# PAGES_TEAM_PORT=9200
# PAGES_TEAM_OWNER_PORT=9201
# PAGES_TEAM_OWNER_SECRET_FILE=~/.craft-agent/pages-team/owner-secret
